# Truvian — environment variables
# Copy to .env (gitignored) and fill in. The same file works locally and on the VPS.

# ─── Truvian Shield (Track 3) ────────────────────────────────────────────────
# Private key of the wallet that PAYS for Telegraph requests via x402
# (USDC on Base Sepolia). 0x-prefixed, 64 hex chars. Never commit this.
# Use a wallet funded with Base Sepolia USDC (x402) and a little Base Sepolia ETH.
TELEGRAPH_PAYER_KEY=

# Transport for Telegraph queries:
#   x402   — paid requests through the Telegraph node (production; requires TELEGRAPH_PAYER_KEY)
#   direct — call live miners' public endpoints from the free catalog (dev/fallback; still real miners)
SHIELD_TRANSPORT=x402

# Telegraph node (Base Sepolia testnet deployment)
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com

# x402 payment rails (Base Sepolia)
X402_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_FACILITATOR_URL=https://facilitator.payai.network
X402_CHAIN_ID=84532

# Shield server bind (behind nginx on the VPS use HOST=127.0.0.1)
SHIELD_PORT=8788
SHIELD_HOST=127.0.0.1

# Public URL of the deployed app (used in share links / X posts)
SHIELD_PUBLIC_URL=https://truvian.xyz

# ─── Truvian miner (Track 1) — already deployed via deploy/ecosystem.config.cjs ─
# PORT=8787
# HOST=127.0.0.1
# TRUVIAN_MINER_ID=truvian-onchain-truth
