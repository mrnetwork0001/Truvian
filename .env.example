# Truvian - environment variables
# Copy to .env (gitignored) and fill in. The same file works locally and on the VPS.

# ─── Truvian Shield (Track 3) ────────────────────────────────────────────────
# Private key of the wallet that PAYS for Telegraph requests via x402
# (USDC on Base Sepolia). 0x-prefixed, 64 hex chars. Never commit this.
# Use a wallet funded with Base Sepolia USDC (x402) and a little Base Sepolia ETH.
TELEGRAPH_PAYER_KEY=

# Transport for Telegraph queries:
#   x402   - paid requests through the Telegraph node (production; requires TELEGRAPH_PAYER_KEY)
#   direct - call live miners' public endpoints from the free catalog (dev/fallback; still real miners)
SHIELD_TRANSPORT=x402

# Telegraph node (Base Sepolia testnet deployment)
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com

# x402 payment rails (Base Sepolia)
X402_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_FACILITATOR_URL=https://facilitator.payai.network
X402_CHAIN_ID=84532

# Shield server bind (behind nginx on the VPS use HOST=127.0.0.1)
SHIELD_PORT=8788
SHIELD_HOST=127.0.0.1

# Public URL of the deployed app (used in share links and in the x402 `resource` field)
SHIELD_PUBLIC_URL=https://truvian.xyz

# ─── Free tier and spend control ─────────────────────────────────────────────
# Every check runs up to four PAID miner queries ($0.01 each), so these caps
# keep an open endpoint from draining the payer wallet. All optional; the
# defaults below are what the code uses when a var is unset.
# SHIELD_FREE_CHECKS_PER_IP=5      # free checks per visitor per UTC day
# SHIELD_BURST_PER_MIN=3           # per-IP checks allowed in any 60s window
# SHIELD_DAILY_CHECK_CAP=300       # checks per UTC day across everyone
# SHIELD_DAILY_SPEND_USD=5         # USD Shield may pay miners per UTC day
# SHIELD_TRUST_PROXY=1             # set 0 only when NOT behind nginx

# ─── Charging for checks (Shield as an x402 service) ─────────────────────────
# Once the free allowance is used, /api/check answers 402 with a price and the
# caller (browser wallet or agent) pays in USDC. Revenue lands at SHIELD_PAYTO.
# SHIELD_PRICE_USD=0.05            # price of one check (miner cost is up to $0.04)
# SHIELD_PAYTO=0x…                 # where revenue goes; defaults to the payer wallet
# SHIELD_PAYMENTS=off              # set to disable charging entirely (free tier only)

# ─── Truvian miner (Track 1) - already deployed via deploy/ecosystem.config.cjs ─
# PORT=8787
# HOST=127.0.0.1
# TRUVIAN_MINER_ID=truvian-onchain-truth
